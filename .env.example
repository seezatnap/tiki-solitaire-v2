# Copy to .env — which is gitignored — and fill in.
#
# Only the artwork scripts in scripts/art/ read this. The game itself needs
# nothing: the deck, the table and the icons are already committed as WebP,
# so `npm run dev` and `npm test` work without a key.
#
# Used by: deck.mjs, scenery.mjs, verify.mjs, recount.mjs, pilot.mjs
OPENAI_API_KEY=
